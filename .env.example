# --- Datenbank ---------------------------------------------------------------
DATABASE_URL="postgresql://sproessling:CHANGE_ME@localhost:5432/sproessling?schema=public"

# --- Sicherheit --------------------------------------------------------------
# 32+ zufaellige Bytes, z.B. `openssl rand -base64 48`
SESSION_SECRET="CHANGE_ME_openssl_rand_base64_48"
# Erster Einladungscode fuer die Registrierung des ersten Users (Seed).
BOOTSTRAP_INVITE_CODE="CHANGE_ME"

# --- Web Push (VAPID) --------------------------------------------------------
# Erzeugen mit: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.org"

# Geheimnis fuer den Erinnerungs-Endpunkt (Cron-Sidecar).
# Erzeugen mit: openssl rand -hex 32
CRON_SECRET=""

# --- Betrieb -----------------------------------------------------------------
# Basis-URL hinter dem Cloudflare Tunnel (fuer absolute Links in Push-Nachrichten)
APP_URL="https://sproessling.example.org"
# Ablageort fuer Uploads (Fotos, eigene Sounds)
UPLOAD_DIR="./data/uploads"
# Backup-Volume, das der Sidecar beschreibt und die App nur liest.
# Fehlt es (lokale Entwicklung), sagt die App das offen statt zu behaupten,
# es gaebe Sicherungen.
BACKUP_DIR="/backups"
TZ="Europe/Vienna"
# Session-Cookies nur ueber HTTPS senden. Standard: an, sobald NODE_ENV=production.
# Nur auf "false" setzen, wenn die App bewusst ohne TLS erreichbar ist.
COOKIE_SECURE="
